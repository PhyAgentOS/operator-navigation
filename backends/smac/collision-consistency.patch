+bool GridCollisionChecker::isMotionValid(
+  float x0, float y0, float bin0, float x1, float y1, float bin1, bool traverse_unknown)
+{
+  if (outsideRange(angles_.size(), bin0) || outsideRange(angles_.size(), bin1)) {
+    return false;
+  }
+  nav_msgs::msg::Path edge;
+  geometry_msgs::msg::PoseStamped p;
+  p.pose = getWorldCoords(x0, y0, costmap_);
+  p.pose.orientation = getWorldOrientation(angles_[static_cast<unsigned int>(bin0)]);
+  edge.poses.push_back(p);
+  p.pose = getWorldCoords(x1, y1, costmap_);
+  p.pose.orientation = getWorldOrientation(angles_[static_cast<unsigned int>(bin1)]);
+  edge.poses.push_back(p);
+  return validOutputPath(edge, costmap_, unoriented_footprint_, footprint_is_radius_,
+    traverse_unknown);
+}
