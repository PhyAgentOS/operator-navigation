+// Copyright 2026 Navigation contributors. Licensed under Apache-2.0.
+#ifndef NAVIGATION_SMAC_OUTPUT_VALIDATION_HPP_
+#define NAVIGATION_SMAC_OUTPUT_VALIDATION_HPP_
+#include <algorithm>
+#include <cmath>
+#include <nav_msgs/msg/path.hpp>
+#include <nav2_costmap_2d/footprint_collision_checker.hpp>
+#include <tf2/utils.h>
+#include <tf2_geometry_msgs/tf2_geometry_msgs.hpp>
+
+namespace nav2_smac_planner
+{
+// The caller holds the costmap lock and a single footprint snapshot. This checks
+// native rasterized contours, not an exact continuous 3-D swept volume.
+inline bool validOutputPose(
+  double x, double y, double yaw, nav2_costmap_2d::Costmap2D * map,
+  const nav2_costmap_2d::Footprint & footprint, bool radius, bool allow_unknown)
+{
+  if (!std::isfinite(x) || !std::isfinite(y) || !std::isfinite(yaw)) {return false;}
+  unsigned int mx, my;
+  if (!map->worldToMap(x, y, mx, my)) {return false;}
+  auto cost = map->getCost(mx, my);
+  if (cost == nav2_costmap_2d::NO_INFORMATION) {
+    if (!allow_unknown) {return false;}
+  } else if (cost >= nav2_costmap_2d::INSCRIBED_INFLATED_OBSTACLE) {
+    return false;
+  }
+  if (radius) {return true;}
+  if (footprint.size() < 3) {return false;}
+  nav2_costmap_2d::Footprint oriented;
+  oriented.reserve(footprint.size());
+  const double c = std::cos(yaw), s = std::sin(yaw);
+  for (const auto & p : footprint) {
+    geometry_msgs::msg::Point q;
+    q.x = x + p.x * c - p.y * s;
+    q.y = y + p.x * s + p.y * c;
+    if (!std::isfinite(q.x) || !std::isfinite(q.y) ||
+      !map->worldToMap(q.x, q.y, mx, my)) {return false;}
+    oriented.push_back(q);
+  }
+  nav2_costmap_2d::FootprintCollisionChecker<nav2_costmap_2d::Costmap2D *> checker(map);
+  const double contour_cost = checker.footprintCost(oriented);
+  return contour_cost < nav2_costmap_2d::LETHAL_OBSTACLE ||
+         (allow_unknown && contour_cost == nav2_costmap_2d::NO_INFORMATION);
+}
+
+inline bool validOutputPath(
+  const nav_msgs::msg::Path & path, nav2_costmap_2d::Costmap2D * map,
+  const nav2_costmap_2d::Footprint & footprint, bool radius, bool allow_unknown)
+{
+  if (path.poses.empty()) {return false;}
+  double reach = 0.0;
+  for (const auto & p : footprint) {reach = std::max(reach, std::hypot(p.x, p.y));}
+  const double step = map->getResolution() * 0.5;
+  for (size_t i = 0; i < path.poses.size(); ++i) {
+    const auto & b = path.poses[i].pose;
+    const double byaw = tf2::getYaw(b.orientation);
+    if (!validOutputPose(b.position.x, b.position.y, byaw, map,
+      footprint, radius, allow_unknown)) {return false;}
+    if (i == 0) {continue;}
+    const auto & a = path.poses[i - 1].pose;
+    const double ayaw = tf2::getYaw(a.orientation);
+    const double dyaw = std::remainder(byaw - ayaw, 2.0 * M_PI);
+    const double length = std::hypot(b.position.x - a.position.x, b.position.y - a.position.y);
+    // Bound displacement of any footprint point, including rotation. These
+    // samples guard gaps between returned poses; finite sampling is not CCD.
+    const double count = std::ceil((length + reach * std::abs(dyaw)) / step);
+    if (!std::isfinite(count) || count > 100000) {return false;}
+    const size_t n = std::max<size_t>(1, static_cast<size_t>(count));
+    for (size_t j = 1; j < n; ++j) {
+      const double t = static_cast<double>(j) / n;
+      if (!validOutputPose(
+          a.position.x + t * (b.position.x - a.position.x),
+          a.position.y + t * (b.position.y - a.position.y), ayaw + t * dyaw,
+          map, footprint, radius, allow_unknown)) {return false;}
+    }
+  }
+  return true;
+}
+}  // namespace nav2_smac_planner
+#endif
